{
  "name": "webhook-delivery",
  "version": "0.0.0",
  "private": true,
  "description": "A lightweight webhook delivery engine: a Sender that signs and reliably delivers Events, and a Receiver kit that verifies and deduplicates them.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./sender": {
      "source": "./src/sender/index.ts",
      "types": "./dist/sender/index.d.ts",
      "default": "./dist/sender/index.js"
    },
    "./receiver": {
      "source": "./src/receiver/index.ts",
      "types": "./dist/receiver/index.d.ts",
      "default": "./dist/receiver/index.js"
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "lint:boundaries": "depcruise src test"
  },
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@types/node": "^22.20.5",
    "dependency-cruiser": "^18.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
